#!/usr/bin/env bash
set -euo pipefail

dotfiles_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
home_dir="${HOME:?HOME must be set}"
timestamp="$(date +%Y%m%d%H%M%S)"
dry_run=0
skip_shell_change=0
skip_devops_tools=0
enable_vicinae_gnome_shortcut=0

usage() {
  cat <<'EOF'
Usage: install-dotfiles [options]

Install this repository on Fedora or macOS.

Options:
  --dry-run             Show actions without changing the system
  --no-shell-change     Keep the current login shell on macOS
  --skip-devops-tools   Do not run bin/install-devops-tools
  --enable-vicinae-gnome-shortcut
                        Opt in to the experimental GNOME Vicinae shortcut
  -h, --help            Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --no-shell-change) skip_shell_change=1 ;;
    --skip-devops-tools) skip_devops_tools=1 ;;
    --enable-vicinae-gnome-shortcut) enable_vicinae_gnome_shortcut=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

run() {
  if [ "$dry_run" -eq 1 ]; then
    printf '+ %s\n' "$*"
  else
    "$@"
  fi
}

backup_existing() {
  local target="$1"
  local backup="${target}.backup.${timestamp}"

  if [ -e "$target" ] || [ -L "$target" ]; then
    run mv -- "$target" "$backup"
    printf 'Backed up %s to %s\n' "$target" "$backup"
  fi
}

link_entry() {
  local relative_path="$1"
  local source="$dotfiles_root/$relative_path"
  local target="$home_dir/$relative_path"

  if [ -L "$target" ] && [ "$(readlink -- "$target")" = "$source" ]; then
    return
  fi

  run mkdir -p -- "$(dirname -- "$target")"
  backup_existing "$target"
  run ln -s -- "$source" "$target"
  printf 'Linked %s\n' "$target"
}

install_homebrew_packages() {
  if ! command -v brew >/dev/null 2>&1; then
    printf 'Homebrew is required on macOS: https://brew.sh/\n' >&2
    exit 1
  fi

  run brew install bash tmux fzf ripgrep bat vim rsync shellcheck
  run brew install --cask ghostty
}

install_fedora_packages() {
  if ! command -v dnf >/dev/null 2>&1; then
    printf 'This installer supports Fedora/dnf on Linux only.\n' >&2
    exit 1
  fi

  run sudo dnf install -y bash tmux fzf ripgrep bat vim-enhanced rsync wl-clipboard curl dnf-plugins-core
  run sudo dnf copr enable -y quadratech188/vicinae
  run sudo dnf install -y vicinae
}

install_vicinae_gnome_extension() {
  local desktop_session="${XDG_CURRENT_DESKTOP:-} ${XDG_SESSION_DESKTOP:-} ${DESKTOP_SESSION:-}"
  local extension_uuid="vicinae@dagimg-dot"
  local api_url="https://api.github.com/repos/vicinaehq/gnome-extension/releases/latest"
  local download_url temp_dir extension_zip

  if [[ "$desktop_session" != *GNOME* ]] || ! command -v gnome-extensions >/dev/null 2>&1; then
    printf 'GNOME not detected; skipped Vicinae GNOME extension.\n'
    return
  fi

  if ! command -v curl >/dev/null 2>&1; then
    printf 'Warning: curl not found; skipped Vicinae GNOME extension.\n' >&2
    return
  fi

  if [ "$dry_run" -eq 1 ]; then
    printf '+ download the latest Vicinae GNOME extension\n'
    printf '+ gnome-extensions install --force <vicinae-extension>.shell-extension.zip\n'
    printf '+ gnome-extensions enable %s\n' "$extension_uuid"
    return
  fi

  if gnome-extensions list | grep -Fqx "$extension_uuid"; then
    gnome-extensions enable "$extension_uuid"
    printf 'Vicinae GNOME extension is already installed and enabled.\n'
    return
  fi

  if ! download_url="$(curl --fail --silent --show-error "$api_url" \
    | sed -n 's/.*"browser_download_url": "\([^"]*\.shell-extension[^\"]*\.zip\)".*/\1/p' \
    | head -n 1)"; then
    printf 'Warning: could not query the Vicinae GNOME extension release.\n' >&2
    return
  fi
  if [ -z "$download_url" ]; then
    printf 'Warning: could not find the Vicinae GNOME extension release asset.\n' >&2
    return
  fi

  temp_dir="$(mktemp -d)"
  extension_zip="$temp_dir/vicinae.shell-extension.zip"
  trap 'rm -rf -- "$temp_dir"' RETURN
  curl --fail --silent --show-error --location "$download_url" --output "$extension_zip"
  gnome-extensions install --force "$extension_zip"
  if ! gnome-extensions enable "$extension_uuid"; then
    printf 'GNOME must be restarted before the Vicinae extension can be enabled. Log out/in, then run this installer again.\n' >&2
  fi
  trap - RETURN
  rm -rf -- "$temp_dir"
  printf 'Installed and enabled the Vicinae GNOME extension. Log out/in if GNOME does not activate it immediately.\n'
}

install_vicinae_config() {
  local vicinae_dir="$home_dir/.config/vicinae"
  local settings_file="$vicinae_dir/settings.json"
  local settings_example="$dotfiles_root/.config/vicinae/settings.json.example"

  run mkdir -p "$vicinae_dir/themes"
  link_entry .config/vicinae/themes/deep-nord.toml

  if [ ! -e "$settings_file" ] && [ ! -L "$settings_file" ]; then
    run cp -- "$settings_example" "$settings_file"
    run chmod 600 "$settings_file"
    printf 'Created writable Vicinae settings at %s\n' "$settings_file"
  else
    printf 'Preserved existing Vicinae settings at %s\n' "$settings_file"
  fi

}

configure_gnome_vicinae_shortcut() {
  local keybindings_schema="org.gnome.settings-daemon.plugins.media-keys"
  local keybindings_key="custom-keybindings"
  local keybinding_path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/vicinae/"
  local custom_keybinding_schema="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${keybinding_path}"
  local current_keybindings updated_keybindings

  if ! command -v gsettings >/dev/null 2>&1; then
    printf 'Warning: gsettings not found; configure Alt+Space manually for Vicinae.\n' >&2
    return
  fi

  if [ "$dry_run" -eq 1 ]; then
    printf '+ disable GNOME window menu Alt+Space\n'
    printf '+ configure GNOME Alt+Space -> vicinae toggle\n'
    return
  fi

  # GNOME reserves Alt+Space for the window menu. Release that binding so the
  # Vicinae custom shortcut can receive it instead.
  gsettings set org.gnome.desktop.wm.keybindings activate-window-menu "[]"

  current_keybindings="$(gsettings get "$keybindings_schema" "$keybindings_key")"
  if [[ "$current_keybindings" != *"$keybinding_path"* ]]; then
    if [ "$current_keybindings" = "@as []" ]; then
      updated_keybindings="['$keybinding_path']"
    else
      updated_keybindings="${current_keybindings%]}, '$keybinding_path']"
    fi
    gsettings set "$keybindings_schema" "$keybindings_key" "$updated_keybindings"
  fi

  gsettings set "$custom_keybinding_schema" name 'Vicinae'
  gsettings set "$custom_keybinding_schema" command 'vicinae toggle'
  gsettings set "$custom_keybinding_schema" binding '<Alt>space'
  printf 'Configured GNOME Alt+Space for Vicinae.\n'
}

configure_macos_bash() {
  local bash_path
  bash_path="$(brew --prefix)/bin/bash"

  if [ "$dry_run" -eq 1 ]; then
    printf '+ configure macOS login shell: %s\n' "$bash_path"
    return
  fi

  if [ ! -x "$bash_path" ]; then
    printf 'Homebrew Bash was not found at %s\n' "$bash_path" >&2
    exit 1
  fi

  if [ "$skip_shell_change" -eq 1 ]; then
    printf 'Keeping the current macOS login shell (--no-shell-change).\n'
    return
  fi

  if ! grep -Fqx "$bash_path" /etc/shells 2>/dev/null; then
    if [ "$dry_run" -eq 1 ]; then
      printf '+ sudo tee -a /etc/shells <<< %s\n' "$bash_path"
    else
      printf '%s\n' "$bash_path" | sudo tee -a /etc/shells >/dev/null
    fi
  fi

  if [ "${SHELL:-}" != "$bash_path" ]; then
    run chsh -s "$bash_path"
    printf 'Default shell changed to Homebrew Bash. Open a new terminal session.\n'
  else
    printf 'Homebrew Bash is already the default shell.\n'
  fi
}

case "$(uname -s)" in
  Darwin)
    install_homebrew_packages
    ;;
  Linux)
    if [ ! -f /etc/fedora-release ]; then
      printf 'Linux was detected, but this installer is intended for Fedora.\n' >&2
      exit 1
    fi
    install_fedora_packages
    ;;
  *)
    printf 'Unsupported operating system: %s\n' "$(uname -s)" >&2
    exit 1
    ;;
esac

for entry in \
  .bashrc \
  .bash_profile \
  .bashrc.d \
  .gitconfig \
  .inputrc \
  .tmux.conf \
  .tmux.d \
  .vimrc \
  .vimrc.d \
  .config/ghostty/config.ghostty \
  .config/vicinae/themes/deep-nord.toml; do
  link_entry "$entry"
done

run mkdir -p "$home_dir/.local/bin"
for source_file in "$dotfiles_root"/bin/*; do
  [ -f "$source_file" ] || continue
  [ "$(basename -- "$source_file")" = "claude" ] && continue
  target="$home_dir/.local/bin/$(basename -- "$source_file")"
  if [ -L "$target" ] && [ "$(readlink -- "$target")" = "$source_file" ]; then
    continue
  fi
  backup_existing "$target"
  run ln -s -- "$source_file" "$target"
  printf 'Linked %s\n' "$target"
done

if [ "$(uname -s)" = Darwin ]; then
  configure_macos_bash
else
  install_vicinae_config
  install_vicinae_gnome_extension
  if [ "$enable_vicinae_gnome_shortcut" -eq 1 ]; then
    configure_gnome_vicinae_shortcut
    run systemctl --user enable --now vicinae.service
  else
    printf 'Vicinae installed without GNOME autostart/shortcut; start it manually with: systemctl --user start vicinae.service\n'
  fi
fi

if [ "$skip_devops_tools" -eq 0 ]; then
  run "$dotfiles_root/bin/install-devops-tools"
fi

if command -v code >/dev/null 2>&1; then
  run "$dotfiles_root/bin/install-vscode-config"
else
  printf 'Warning: code CLI not found; skipped VS Code settings and extensions.\n'
fi

printf '\nDotfiles installation complete. Start a new terminal session to load Bash.\n'
