#!/usr/bin/env bash
set -euo pipefail

target_pane="${TMUX_FZF_TARGET_PANE:-}"

if [[ -z "$target_pane" ]]; then
  tmux display-message "fzf open-file: missing target pane"
  exit 1
fi

list_files() {
  if command -v rg >/dev/null 2>&1; then
    rg --files --hidden --glob '!.git/*' 2>/dev/null
  else
    find . -type f -not -path '*/.git/*' -print | sed 's#^\./##'
  fi
}

set +e
selected="$(
  set +o pipefail
  list_files | fzf \
    --prompt='Open file> ' \
    --layout=reverse \
    --border=none \
    --preview='sed -n "1,160p" {} 2>/dev/null' \
    --preview-window='right:60%:wrap'
)"
fzf_status=$?
set -e

if [[ $fzf_status -ne 0 || -z "$selected" ]]; then
  exit 0
fi

if absolute_path="$(realpath -- "$selected" 2>/dev/null)"; then
  selected="$absolute_path"
fi

printf -v quoted_file '%q' "$selected"
tmux send-keys -t "$target_pane" "vim -- $quoted_file" C-m
