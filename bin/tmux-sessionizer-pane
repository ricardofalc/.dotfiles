#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/git -mindepth 1 -maxdepth 1 -type d | fzf \
        --color='bg:#151820,bg+:#3b4252,fg:#d8dee9,fg+:#eceff4,pointer:#88c0d0,marker:#a3be8c,prompt:#88c0d0,info:#81a1c1,header:#81a1c1,border:#4c566a')
fi

if [[ -z $selected ]]; then
    exit 0
fi

window_name=$(basename "$selected" | tr . _)

if [[ -n $TMUX ]]; then
    tmux split-window -h -c "$selected"
else
    tmux new-session -A -s "$window_name" -c "$selected"
fi
