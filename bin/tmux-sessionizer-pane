#!/usr/bin/env bash                                                                                                                                                                                                
                                                                                                                                                                                                                   
if [[ $# -eq 1 ]]; then                                                                                                                                                                                            
    selected=$1                                                                                                                                                                                                    
else                                                                                                                                                                                                               
    # Searches .git folder (2 deep)                                                                                                                                                                                
    # Finds ~/Documents/git/GROUP/REPO                                                                                                                                                                             
    selected=$(find ~/Documents/git -mindepth 2 -maxdepth 2 -type d | fzf)                                                                                                                            
fi                                                                                                                                                                                                                 
                                                                                                                                                                                                                   
if [[ -z $selected ]]; then                                                                                                                                                                                        
    exit 0                                                                                                                                                                                                         
fi                                                                                                                                                                                                                 
                                                                                                                                                                                                                   
window_name=$(basename "$selected" | tr . _)                                                                                                                                                                       
                                                                                                                                                                                                                   
if [[ -n $TMUX ]]; then                                                                                                                                                                                            
    tmux split-window -h -c "$selected"                                                                                                                                                               
else                                                                                                                                                                                                               
    tmux new-session -A -s "$window_name" -c "$selected"                                                                                                                                                           
fi                                                                                                                                                                                                                 
~                                                                                                                                                                                                                  
~         
