# Shared Ghostty appearance.
# Keep this palette aligned with .tmux.d/30-theme-nord.conf, with a darker
# background and more saturated ANSI colors for better terminal contrast.

background = #151820
foreground = #d8dee9
cursor-color = #8fbcbb
cursor-text = #151820
selection-background = #475164
selection-foreground = #eceff4
background-opacity = 1
font-family = Noto Sans Mono
font-size = 11
font-thicken = true

# Keep the window and terminal title useful instead of showing only the home
# directory (`~`) through shell integration.
title = Ghostty

# Nord Deep palette: the same cool hues, made more visible on dark surfaces.
palette = 0=#151820
palette = 1=#d8616d
palette = 2=#a8c77b
palette = 3=#f0c674
palette = 4=#56c6d1
palette = 5=#c792ea
palette = 6=#56c6d1
palette = 7=#d8dee9
palette = 8=#4b556a
palette = 9=#f07178
palette = 10=#b5d58c
palette = 11=#f3d17a
palette = 12=#79d5df
palette = 13=#d6a4f0
palette = 14=#79d5df
palette = 15=#ffffff

# A little breathing room without changing the terminal's proportions.
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# Ghostty's shell integration improves working-directory and prompt behavior.
shell-integration = detect
shell-integration-features = cursor,no-sudo,no-ssh-env,no-ssh-terminfo,path

